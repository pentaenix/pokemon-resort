#!/usr/bin/env bash
# Pokemon Resort CLI — usage: pkr build | pkr run | pkr --newgame --confirm | pkr recover <pkrid> | ...
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
PR_DIR="${PKR_PROJECT_DIR:-$REPO_ROOT}"
BUILD_DIR="$PR_DIR/build"
BRIDGE_DIR="$REPO_ROOT/tools/pkhex_bridge"
OPENHOME_DIR="$REPO_ROOT/tools/OpenHome"

# Prepended when invoking OpenHome's pnpm scripts (wasm-pack, node).
PKR_OPENHOME_PATH_DEFAULT="/opt/homebrew/opt/rustup/bin:/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/bin:/bin"

warn_if_stray_repo_root_build() {
    local stray="$REPO_ROOT/build"
    if [[ -d "$stray" && "$stray" != "$BUILD_DIR" ]]; then
        echo "pkr: warning: found a second build tree at $stray" >&2
        echo "pkr:          use only $BUILD_DIR (this script always configures there)." >&2
        echo "pkr:          delete the stray copy: rm -rf \"$stray\"" >&2
    fi
}

cmake_jobs() {
    if command -v nproc >/dev/null 2>&1; then
        echo "-j$(nproc)"
    elif command -v sysctl >/dev/null 2>&1; then
        echo "-j$(sysctl -n hw.ncpu 2>/dev/null || echo 4)"
    else
        echo "-j4"
    fi
}

usage() {
    sed 's/^        //' <<'EOF'
        Pokemon Resort — pkr

        pkr run              Configure (if needed), incremental build, run the game
        pkr run --bridge     Same, but build PKHeX bridge + OpenHome resort-bridge first (recommended if you changed either bridge)
        pkr run --clean      Clear transfer cache, clean PKHeX bridge, clean CMake rebuild, build OpenHome resort-bridge, run the game
        pkr run --clean --chlorine   Same as --clean, then: replace ../saves with ../saves_backup (mirrors SaveLibrary),
                              then reset Resort DB like "pkr newgame --confirm" (repeatable test harness)
        pkr run --openhome   Build (same as pkr run), then launch OpenHome UI instead of the game (see pkr openhome)
        pkr dev              Same as pkr run
        pkr build            Incremental CMake build only
        pkr mapbuilder       Build and launch the standalone native map editor
                             (extra arguments are passed to the editor)
        pkr build --bridge   CMake build, then PKHeX publish + OpenHome resort-bridge build
        pkr build --all      Full clean rebuild (removes build/, reconfigure, rebuild all)
        pkr build --all --bridge   Clean rebuild game + both bridges
        pkr build -all       Same as --all
        pkr bridge           dotnet build + dotnet publish for tools/pkhex_bridge (updates publish/<rid>/ for releases)
        pkr bridge-openhome  Build only the headless OpenHome CLI (tools/OpenHome/dist/resort-bridge/resortBridge.mjs)
        pkr openhome         Run OpenHome desktop UI (pnpm tauri dev). Optional: pkr openhome web  (browser-only vite dev)
        pkr clear            Delete transfer probe cache (same as game --clear-save-cache); needs a built binary
        pkr clear --openhome Remove OpenHome UI build outputs under tools/OpenHome/dist/ except dist/resort-bridge/ (headless bridge kept)
        pkr recover <pkrid>  Emergency recovery: put a canonical Pokemon in the first available Resort slot
        pkr reset-resort     DANGEROUS: wipe Resort profile (requires --confirm RESET)
        pkr --newgame --confirm   Same as reset-resort; shorthand for testing (order: --newgame --confirm or --confirm --newgame)
        pkr newgame --confirm     Same as above via subcommand

        Build output always goes to: <repo>/build
        (If you also have <repo>/build from an old cmake command, remove it — it confuses which binary to run.)

        PKHeX bridge (transfer / future save I/O):
          Run "pkr bridge" before shipping or after changing BridgeConsole / BridgeProbe so tools/pkhex_bridge/publish/
          matches bin/Release. The game prefers bin/Release/net10.0 over publish/ when both exist; stale publish/ alone
          used to emit minimal JSON and break box sprites. Override binary: PKHEX_BRIDGE_EXECUTABLE=/path/to/PKHeXBridge

        OpenHome (headless resort bridge + optional UI):
          Native code calls tools/OpenHome/dist/resort-bridge/resortBridge.mjs. Use pkr bridge-openhome or
          pkr run --bridge / pkr run --clean to rebuild it. Override node: OPENHOME_NODE_EXECUTABLE.
          Path for pnpm scripts: PKR_OPENHOME_PATH (default prepends common Homebrew rust + node@22 when present)

        Environment:
          PKR_PROJECT_DIR     Override path to pokemon-resort (default: this repo root)
          PKR_RESORT_DB       Override Resort SQLite DB path for pkr recover
          PKHEX_BRIDGE_RID    dotnet publish runtime id (default: osx-arm64 on Apple silicon, osx-x64 on Intel Mac,
                              linux-x64 on Linux, win-x64 on Windows MSYS)

        Chlorine / saves (with pkr run --clean --chlorine):
          PKR_SAVES_DIR             Target saves folder (default: <repo>/../saves, same as SaveLibrary)
          PKR_CHLORINE_SAVES_BACKUP Source folder to copy from (default: <repo>/../saves_backup)
          PKR_CHLORINE_PROFILE      Resort profile id for reset (default: default)

        Extra args after pkr run / pkr dev are passed to title_screen_demo (e.g. config path), except --bridge, --clean,
        --chlorine, and --openhome are consumed by pkr.
EOF
}

ensure_pr_dir() {
    if [[ ! -d "$PR_DIR" ]]; then
        echo "pkr: missing project directory: $PR_DIR" >&2
        exit 1
    fi
    if [[ ! -f "$PR_DIR/CMakeLists.txt" ]]; then
        echo "pkr: no CMakeLists.txt in $PR_DIR" >&2
        exit 1
    fi
}

ensure_bridge_dir() {
    if [[ ! -f "$BRIDGE_DIR/PKHeXBridge.csproj" ]]; then
        echo "pkr: missing PKHeX bridge project: $BRIDGE_DIR/PKHeXBridge.csproj" >&2
        exit 1
    fi
}

pkr_bridge_rid() {
    if [[ -n "${PKHEX_BRIDGE_RID:-}" ]]; then
        echo "$PKHEX_BRIDGE_RID"
        return
    fi
    case "$(uname -s 2>/dev/null)" in
        Darwin)
            case "$(uname -m 2>/dev/null)" in
                arm64) echo osx-arm64 ;;
                *) echo osx-x64 ;;
            esac
            ;;
        Linux) echo linux-x64 ;;
        MINGW*|MSYS*|CYGWIN*) echo win-x64 ;;
        *) echo osx-arm64 ;;
    esac
}

pkr_bridge() {
    ensure_bridge_dir
    if ! command -v dotnet >/dev/null 2>&1; then
        echo "pkr: dotnet not found; install .NET SDK to build PKHeXBridge" >&2
        exit 1
    fi
    local rid out
    rid="$(pkr_bridge_rid)"
    out="publish/$rid"
    echo "pkr: PKHeX bridge dotnet build + publish (RID=$rid -> tools/pkhex_bridge/$out)"
    (
        cd "$BRIDGE_DIR"
        dotnet build -c Release
        dotnet publish -c Release -r "$rid" -o "$out" --self-contained true
    )
}

clear_transfer_cache_best_effort() {
    # The canonical cache lives in SDL_GetPrefPath(org, app)/transfer_save_cache.json.
    # We mirror App.cpp's resolveSaveDirectory behavior here so pkr can clear cache
    # without requiring a previously-built native binary.
    local root="$PR_DIR"
    local org app
    org="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["persistence"]["organization"])' "$root/config/title_screen.json" 2>/dev/null || true)"
    app="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["persistence"]["application"])' "$root/config/title_screen.json" 2>/dev/null || true)"

    local removed_any=false
    if [[ -n "${org:-}" && -n "${app:-}" ]]; then
        case "$(uname -s 2>/dev/null)" in
            Darwin)
                local p="$HOME/Library/Application Support/$org/$app/transfer_save_cache.json"
                if [[ -f "$p" ]]; then
                    echo "pkr: clearing transfer_save_cache (direct) -> $p"
                    if rm -f "$p" 2>/dev/null; then
                        removed_any=true
                    else
                        echo "pkr: warning: could not remove $p (permission denied?)" >&2
                    fi
                fi
                ;;
        esac
    fi

    # Fallback path used when SDL_GetPrefPath fails: <root>/save/transfer_save_cache.json
    local fallback="$root/save/transfer_save_cache.json"
    if [[ -f "$fallback" ]]; then
        echo "pkr: clearing transfer_save_cache (fallback) -> $fallback"
        if rm -f "$fallback" 2>/dev/null; then
            removed_any=true
        else
            echo "pkr: warning: could not remove $fallback" >&2
        fi
    fi

    if ! $removed_any; then
        echo "pkr: no transfer_save_cache.json found to clear (best effort)"
    fi
}

pkr_bridge_clean() {
    ensure_bridge_dir
    if ! command -v dotnet >/dev/null 2>&1; then
        echo "pkr: dotnet not found; install .NET SDK to build PKHeXBridge" >&2
        exit 1
    fi
    local rid out
    rid="$(pkr_bridge_rid)"
    out="publish/$rid"
    echo "pkr: PKHeX bridge clean rebuild (RID=$rid)"
    (
        cd "$BRIDGE_DIR"
        rm -rf bin obj "$out"
        dotnet build -c Release
        dotnet publish -c Release -r "$rid" -o "$out" --self-contained true
    )
}

pkr_openhome_path_for_pnpm() {
    if [[ -n "${PKR_OPENHOME_PATH:-}" ]]; then
        export PATH="$PKR_OPENHOME_PATH:$PATH"
    else
        export PATH="$PKR_OPENHOME_PATH_DEFAULT:$PATH"
    fi
}

pkr_ensure_openhome_dir() {
    if [[ ! -f "$OPENHOME_DIR/package.json" ]]; then
        echo "pkr: missing OpenHome: $OPENHOME_DIR/package.json" >&2
        exit 1
    fi
}

pkr_bridge_openhome() {
    pkr_ensure_openhome_dir
    if ! command -v pnpm >/dev/null 2>&1; then
        echo "pkr: pnpm not found; install pnpm to build OpenHome resort-bridge" >&2
        exit 1
    fi
    pkr_openhome_path_for_pnpm
    echo "pkr: OpenHome resort-bridge (pnpm run resort-bridge:build -> tools/OpenHome/dist/resort-bridge/)"
    (
        cd "$OPENHOME_DIR"
        pnpm run resort-bridge:build
    )
}

pkr_clear_openhome_ui() {
    local d="$OPENHOME_DIR/dist"
    if [[ ! -d "$d" ]]; then
        echo "pkr: no OpenHome dist/ to clear -> $d"
        return 0
    fi
    local removed=false
    local item base
    shopt -s nullglob
    for item in "$d"/*; do
        [[ -e "$item" ]] || continue
        base=$(basename "$item")
        if [[ "$base" == "resort-bridge" ]]; then
            continue
        fi
        echo "pkr: removing $item"
        rm -rf "$item"
        removed=true
    done
    shopt -u nullglob
    if ! $removed; then
        echo "pkr: OpenHome dist/ had no UI artifacts to remove (resort-bridge/ kept)"
    fi
    echo "pkr: OpenHome UI artifacts cleared (kept dist/resort-bridge/ for headless bridge)"
}

pkr_openhome_ui_launch() {
    pkr_ensure_openhome_dir
    if [[ ! -d "$OPENHOME_DIR/node_modules" ]]; then
        echo "pkr: OpenHome has no node_modules; run: cd $OPENHOME_DIR && pnpm install" >&2
        exit 1
    fi
    if ! command -v pnpm >/dev/null 2>&1; then
        echo "pkr: pnpm not found" >&2
        exit 1
    fi
    pkr_openhome_path_for_pnpm
    local mode="${1:-}"
    if [[ "$mode" == "web" ]]; then
        shift
        echo "pkr: OpenHome web UI (pnpm run dev)"
        (cd "$OPENHOME_DIR" && exec pnpm run dev "$@")
    else
        echo "pkr: OpenHome desktop UI (pnpm run tauri dev)"
        (cd "$OPENHOME_DIR" && exec pnpm run tauri dev "$@")
    fi
}

configure_if_needed() {
    if [[ ! -f "$BUILD_DIR/CMakeCache.txt" ]]; then
        echo "pkr: configuring CMake -> $BUILD_DIR"
        cmake -S "$PR_DIR" -B "$BUILD_DIR"
    fi
}

pkr_build_incremental() {
    ensure_pr_dir
    warn_if_stray_repo_root_build
    configure_if_needed
    echo "pkr: incremental build"
    cmake --build "$BUILD_DIR" "$(cmake_jobs)"
}

pkr_build_all() {
    ensure_pr_dir
    warn_if_stray_repo_root_build
    echo "pkr: clean rebuild (removing $BUILD_DIR)"
    rm -rf "$BUILD_DIR"
    echo "pkr: configuring CMake"
    cmake -S "$PR_DIR" -B "$BUILD_DIR"
    echo "pkr: building all targets"
    cmake --build "$BUILD_DIR" "$(cmake_jobs)"
}

pkr_mapbuilder() {
    ensure_pr_dir
    warn_if_stray_repo_root_build
    configure_if_needed
    echo "pkr: building standalone Pokemon Resort Map Maker"
    cmake --build "$BUILD_DIR" --target pokemon_resort_map_maker "$(cmake_jobs)"
    local exe="$BUILD_DIR/pokemon_resort_map_maker"
    if [[ ! -x "$exe" && ! -f "$exe" ]]; then
        echo "pkr: expected map builder executable not found: $exe" >&2
        exit 1
    fi
    echo "pkr: running $exe"
    (cd "$PR_DIR" && exec "$exe" "$@")
}

# Same path resolution as SaveLibrary::savesDirectory() (project root parent / saves).
pkr_saves_dir() {
    echo "${PKR_SAVES_DIR:-$PR_DIR/../saves}"
}

pkr_chlorine_saves_backup_dir() {
    echo "${PKR_CHLORINE_SAVES_BACKUP:-$PR_DIR/../saves_backup}"
}

pkr_chlorine_restore_saves() {
    local saves_dir backup_dir
    saves_dir="$(pkr_saves_dir)"
    backup_dir="$(pkr_chlorine_saves_backup_dir)"
    if [[ ! -d "$backup_dir" ]]; then
        echo "pkr: --chlorine: backup saves directory not found: $backup_dir" >&2
        echo "pkr: create it (e.g. copy your golden saves there) or set PKR_CHLORINE_SAVES_BACKUP" >&2
        exit 1
    fi
    mkdir -p "$saves_dir"
    echo "pkr: --chlorine: replacing $(readlink -f "$saves_dir" 2>/dev/null || echo "$saves_dir")"\
         "with contents of $(readlink -f "$backup_dir" 2>/dev/null || echo "$backup_dir")"
    if command -v rsync >/dev/null 2>&1; then
        rsync -a --delete "$backup_dir"/ "$saves_dir"/
    else
        find "$saves_dir" -mindepth 1 -exec rm -rf {} +
        shopt -s dotglob nullglob
        local f
        for f in "$backup_dir"/* "$backup_dir"/.[!.]* "$backup_dir"/..?*; do
            [[ -e "$f" ]] || continue
            cp -a "$f" "$saves_dir"/
        done
        shopt -u dotglob nullglob
    fi
}

# Same as pkr newgame --confirm (Resort DB reset); expects resort_backend_tool already built.
pkr_chlorine_reset_resort_newgame() {
    ensure_pr_dir
    local profile="${PKR_CHLORINE_PROFILE:-default}"
    local db
    db="$(pkr_resort_db_path)"
    if [[ ! -f "$db" ]]; then
        echo "pkr: --chlorine: Resort database not found: $db" >&2
        echo "pkr: run the game once or pass PKR_RESORT_DB" >&2
        exit 1
    fi
    local tool="$BUILD_DIR/resort_backend_tool"
    if [[ ! -x "$tool" && ! -f "$tool" ]]; then
        echo "pkr: --chlorine: expected resort_backend_tool after build: $tool" >&2
        exit 1
    fi
    echo "pkr: --chlorine: Resort newgame reset (same as pkr newgame --confirm, profile=$profile)"
    "$tool" reset --db "$db" --profile "$profile" --confirm RESET
}

pkr_run() {
    local with_bridge=false
    local clean=false
    local run_openhome=false
    local chlorine=false
    local forward=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --bridge)
                with_bridge=true
                shift
                ;;
            --clean)
                clean=true
                with_bridge=true
                shift
                ;;
            --chlorine)
                chlorine=true
                shift
                ;;
            --openhome)
                run_openhome=true
                shift
                ;;
            *)
                forward+=("$1")
                shift
                ;;
        esac
    done

    # Bash 3.2 + set -u: "${forward[@]}" errors when the array is empty.
    if ((${#forward[@]})); then
        set -- "${forward[@]}"
    else
        set --
    fi

    if $chlorine && ! $clean; then
        echo "pkr: --chlorine requires --clean (e.g. pkr run --clean --chlorine)" >&2
        exit 2
    fi

    if $clean; then
        clear_transfer_cache_best_effort
        pkr_bridge_clean
        pkr_bridge_openhome
        pkr_build_all
        if $chlorine; then
            pkr_chlorine_restore_saves
            pkr_chlorine_reset_resort_newgame
        fi
    else
        if $with_bridge; then
            pkr_bridge
            pkr_bridge_openhome
        fi
        pkr_build_incremental
    fi

    if $run_openhome; then
        pkr_openhome_ui_launch "$@"
        return
    fi

    local exe="$BUILD_DIR/title_screen_demo"
    if [[ ! -x "$exe" ]] && [[ ! -f "$exe" ]]; then
        echo "pkr: expected executable not found: $exe" >&2
        exit 1
    fi
    echo "pkr: running $exe"
    (cd "$PR_DIR" && exec "$exe" "$@")
}

pkr_clear() {
    local openhome=false
    local forward=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --openhome)
                openhome=true
                shift
                ;;
            *)
                forward+=("$1")
                shift
                ;;
        esac
    done
    if $openhome; then
        if ((${#forward[@]})); then
            echo "pkr: clear --openhome does not take extra args (got: ${forward[*]})" >&2
            exit 1
        fi
        pkr_clear_openhome_ui
        return 0
    fi
    ensure_pr_dir
    local exe="$BUILD_DIR/title_screen_demo"
    if [[ ! -f "$exe" ]]; then
        echo "pkr: build the game first: pkr build" >&2
        exit 1
    fi
    echo "pkr: clearing transfer_save_cache (via title_screen_demo --clear-save-cache)"
    if ((${#forward[@]})); then
        (cd "$PR_DIR" && exec "$exe" --clear-save-cache "${forward[@]}")
    else
        (cd "$PR_DIR" && exec "$exe" --clear-save-cache)
    fi
}

pkr_resort_db_path() {
    if [[ -n "${PKR_RESORT_DB:-}" ]]; then
        echo "$PKR_RESORT_DB"
        return
    fi

    python3 - "$PR_DIR/config/title_screen.json" <<'PY'
import json
import os
import sys
from pathlib import Path

config = json.load(open(sys.argv[1], encoding="utf-8"))
persistence = config.get("persistence", {})
org = persistence.get("organization", "pokemon-resort")
app = persistence.get("application", "pokemon-resort")
db_name = persistence.get("resort_profile_file_name", "profile.resort.db") or "profile.resort.db"

if sys.platform == "darwin":
    base = Path.home() / "Library" / "Application Support" / org / app
else:
    base = Path(sys.argv[1]).resolve().parents[1] / "save"

print(base / db_name)
PY
}

pkr_recover() {
    ensure_pr_dir
    if [[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo "Usage: pkr recover <pkrid> [--db <profile.resort.db>] [--profile <profile_id>]" >&2
        exit 2
    fi

    local pkrid="$1"
    shift
    local db=""
    local profile="default"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --db)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    echo "pkr: --db requires a path" >&2
                    exit 2
                fi
                db="${2:-}"
                shift 2
                ;;
            --profile)
                if [[ $# -lt 2 || -z "${2:-}" ]]; then
                    echo "pkr: --profile requires a profile id" >&2
                    exit 2
                fi
                profile="${2:-}"
                shift 2
                ;;
            *)
                echo "pkr: unknown argument for recover: $1" >&2
                exit 2
                ;;
        esac
    done
    if [[ -z "$db" ]]; then
        db="$(pkr_resort_db_path)"
    fi
    if [[ ! -f "$db" ]]; then
        echo "pkr: Resort database not found: $db" >&2
        echo "pkr: run the game once or pass --db <profile.resort.db>" >&2
        exit 1
    fi

    warn_if_stray_repo_root_build
    configure_if_needed
    echo "pkr: building resort_backend_tool"
    cmake --build "$BUILD_DIR" --target resort_backend_tool "$(cmake_jobs)"

    local tool="$BUILD_DIR/resort_backend_tool"
    if [[ ! -x "$tool" && ! -f "$tool" ]]; then
        echo "pkr: expected backend tool not found: $tool" >&2
        exit 1
    fi
    echo "pkr: recovering $pkrid into first available Resort slot"
    exec "$tool" recover --db "$db" --profile "$profile" --pkrid "$pkrid"
}

pkr_reset_resort() {
    ensure_pr_dir
    local profile="default"
    local db=""
    local backup=""
    local confirm=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile)
                profile="${2:-}"
                shift 2
                ;;
            --db)
                db="${2:-}"
                shift 2
                ;;
            --backup)
                backup="${2:-}"
                shift 2
                ;;
            --confirm)
                confirm="${2:-}"
                shift 2
                ;;
            -h|--help)
                echo "Usage: pkr reset-resort [--profile default] [--db <profile.resort.db>] [--backup <path>] --confirm RESET" >&2
                exit 2
                ;;
            *)
                echo "pkr: unknown argument for reset-resort: $1" >&2
                exit 2
                ;;
        esac
    done
    if [[ "$confirm" != "RESET" ]]; then
        echo "pkr: refusing to reset without --confirm RESET" >&2
        exit 2
    fi
    if [[ -z "$db" ]]; then
        db="$(pkr_resort_db_path)"
    fi
    if [[ ! -f "$db" ]]; then
        echo "pkr: Resort database not found: $db" >&2
        exit 1
    fi

    warn_if_stray_repo_root_build
    configure_if_needed
    echo "pkr: building resort_backend_tool"
    cmake --build "$BUILD_DIR" --target resort_backend_tool "$(cmake_jobs)"
    local tool="$BUILD_DIR/resort_backend_tool"
    echo "pkr: resetting Resort profile (profile=$profile)"
    local ec=0
    if [[ -n "$backup" ]]; then
        "$tool" reset --db "$db" --profile "$profile" --backup "$backup" --confirm RESET || ec=$?
    else
        "$tool" reset --db "$db" --profile "$profile" --confirm RESET || ec=$?
    fi
    exit "$ec"
}

pkr_newgame() {
    local args=()
    local ok=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --confirm)
                ok=true
                args+=(--confirm RESET)
                shift
                ;;
            --profile|--db|--backup)
                if [[ $# -lt 2 ]]; then
                    echo "pkr: $1 requires a value" >&2
                    exit 2
                fi
                args+=("$1" "$2")
                shift 2
                ;;
            -h|--help)
                echo "Usage: pkr newgame --confirm [--profile <id>] [--db <profile.resort.db>] [--backup <path>]" >&2
                echo "       pkr --newgame --confirm   (same)" >&2
                exit 0
                ;;
            *)
                echo "pkr: unknown argument for newgame: $1" >&2
                exit 2
                ;;
        esac
    done
    if ! $ok; then
        echo "pkr: refusing newgame without --confirm" >&2
        exit 2
    fi
    pkr_reset_resort "${args[@]}"
}

if [[ (${1:-} == --newgame && ${2:-} == --confirm) || (${1:-} == --confirm && ${2:-} == --newgame) ]]; then
    shift 2
    exec "$0" newgame --confirm "$@"
fi

cmd="${1:-}"
case "$cmd" in
    ""|-h|--help|help)
        usage
        ;;
    build)
        shift
        all=false
        with_bridge=false
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -all|--all)
                    all=true
                    shift
                    ;;
                --bridge)
                    with_bridge=true
                    shift
                    ;;
                -h|--help)
                    usage
                    exit 0
                    ;;
                *)
                    echo "pkr: unknown option for build: $1" >&2
                    echo "Try: pkr build   or   pkr build --all   or   pkr build --bridge" >&2
                    exit 1
                    ;;
            esac
        done
        if $all; then
            pkr_build_all
        else
            pkr_build_incremental
        fi
        if $with_bridge; then
            pkr_bridge
            pkr_bridge_openhome
        fi
        ;;
    mapbuilder|map-builder)
        shift
        pkr_mapbuilder "$@"
        ;;
    bridge-openhome)
        shift
        if [[ $# -gt 0 ]]; then
            echo "pkr: unknown arguments for bridge-openhome: $*" >&2
            exit 1
        fi
        pkr_bridge_openhome
        ;;
    bridge)
        shift
        if [[ $# -gt 0 ]]; then
            echo "pkr: unknown arguments for bridge: $*" >&2
            exit 1
        fi
        pkr_bridge
        ;;
    openhome)
        shift
        pkr_openhome_ui_launch "$@"
        ;;
    run|dev)
        shift
        pkr_run "$@"
        ;;
    clear)
        shift
        pkr_clear "$@"
        ;;
    recover)
        shift
        pkr_recover "$@"
        ;;
    reset-resort)
        shift
        pkr_reset_resort "$@"
        ;;
    newgame)
        shift
        pkr_newgame "$@"
        ;;
    *)
        echo "pkr: unknown command: $cmd" >&2
        usage >&2
        exit 1
        ;;
esac
