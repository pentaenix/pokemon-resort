{
  "window": {
    "width": 800,
    "height": 500,
    "virtual_width": 1280,
    "virtual_height": 800,
    "design_width": 1280,
    "design_height": 800,
    "title": "Pokemon Resort"
  },
  "input": {
    "accept_any_key": true,
    "accept_mouse": true,
    "accept_controller": true,
    "navigate_up_keys": ["UP", "W"],
    "navigate_down_keys": ["DOWN", "S"],
    "navigate_left_keys": ["LEFT", "A"],
    "navigate_right_keys": ["RIGHT", "D"],
    "forward_keys": ["M", "RETURN", "SPACE"],
    "back_keys": ["N", "ESCAPE", "BACKSPACE"],
    "record_toggle_keys": ["R"],
    "screenshot_keys": ["T"]
  },
  "audio": {
    "menu_music": "assets/music/ui_menu_music.mp3",
    "button_sfx": "assets/sfx/btn.mp3",
    "rip_sfx": "assets/sfx/rip.mp3",
    "ui_move_sfx": "assets/sfx/ui_move.mp3",
    "pickup_sfx": "assets/sfx/pickup.mp3",
    "putdown_sfx": "assets/sfx/putdown.mp3",
    "error_sfx": "assets/sfx/error.mp3",
    "save_sfx": "assets/sfx/save.mp3",
    "music_volume": 3,
    "sfx_volume": 8
  },
  "recording": {
    "enabled": true,
    "hotkey": "R"
  },
  "renderer": {
    "world3d_backend": "bgfx",
    "bgfx_preference": "auto"
  },
  "target_fps": 60,
  "enable_frame_counter": true,
  "enable_active_idle_behavior_debug": true
}
